# =============================================================================
# ForgeNest — Stack IA LITE
# Homeserver Edition : ZimaBoard, NAS, Raspberry Pi 5, Mini-PC N100/N305
# =============================================================================
# Utilisation :
#   cp .env.lite.example .env.lite
#   docker compose -f docker-compose.lite.yaml --env-file .env.lite up -d
#
# Ou via le script interactif :
#   bash scripts/deploy.sh

# =============================================================================
# MODÈLE LLAMA.CPP — Fichier GGUF téléchargé automatiquement au 1er démarrage
# =============================================================================
# Placez un modèle manuellement dans volumes/lite/models/ si vous préférez.
#
#  RAM dispo   Modèle recommandé                             Taille
#  ────────── ─────────────────────────────────────────── ───────
#  2-4 GB  →  Qwen2.5-1.5B-Instruct-GGUF / q4_k_m          ~1.0 GB  ← DÉFAUT
#  4-6 GB  →  Phi-3.5-mini-instruct-GGUF  / Q4_K_M          ~2.2 GB
#  6-8 GB  →  Llama-3.2-3B-Instruct-GGUF  / Q4_K_M          ~2.0 GB
#  8-12 GB →  Qwen2.5-7B-Instruct-GGUF    / q4_k_m          ~4.4 GB
#  Code    →  Qwen2.5-Coder-1.5B-Instruct-GGUF / q4_k_m     ~1.0 GB

LLAMACPP_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LLAMACPP_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf

# Token HuggingFace (uniquement si le modèle est "gated")
HF_TOKEN=

# =============================================================================
# PERFORMANCES — Ajustez selon votre matériel
# =============================================================================

# Threads CPU alloués à l'inférence (recommandé : nb cœurs physiques - 1)
#   ZimaBoard 216 (2c) → 2 | ZimaBoard 832 (4c) → 3 | N100 (4c) → 3
LLAMACPP_THREADS=3

# Taille du contexte en tokens (impact direct sur la RAM)
#   1024 = ZimaBoard 216 | 2048 = ZimaBoard 832 ← défaut | 4096 = N100 16GB
LLAMACPP_CTX=2048

# Requêtes parallèles max
#   1 = usage solo | 2 = quelques utilisateurs simultanés
LLAMACPP_PARALLEL=1

# Tokens générés max par réponse
LLAMACPP_MAX_TOKENS=512

# Limites ressources Docker
LLAMACPP_CPU_LIMIT=4.0
LLAMACPP_MEMORY_LIMIT=4G

# =============================================================================
# PORTS
# =============================================================================
WEBUI_PORT=3000          # Open WebUI — interface principale
LITELLM_PORT=4000        # LiteLLM   — cache + routing (utilisé par Open WebUI)
AI_GATEWAY_PORT=8000     # AI Gateway — API unifiée pour outils externes
LLAMACPP_PORT=8081       # llama.cpp  — accès direct (debug)

# =============================================================================
# SÉCURITÉ — ⚠️ Changez ces valeurs en production !
# =============================================================================

# openssl rand -base64 32
LITELLM_MASTER_KEY=sk-lite-changeme-in-production
WEBUI_SECRET_KEY=changeme-lite-webui-secret-32chars-min
WEBUI_AUTH=true

# =============================================================================
# CLÉS API GRATUITES — Optionnelles, utilisées en fallback automatique
# =============================================================================
# Si le modèle local est surchargé, LiteLLM et l'AI Gateway basculent
# automatiquement sur ces APIs selon leur disponibilité.

# ⭐ Groq — Ultra-rapide, 14 400 req/jour GRATUIT
#    https://console.groq.com/
GROQ_API_KEY=

# OpenRouter — Accès à des dizaines de modèles gratuits
#    https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face — Serverless Inference API gratuite
#    https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Together AI — $25 de crédits gratuits à l'inscription
#    https://api.together.xyz/
TOGETHER_API_KEY=

# =============================================================================
# STOCKAGE
# =============================================================================
# Les modèles GGUF sont dans : {VOLUMES_BASE}/lite/models/
VOLUMES_BASE=./volumes

# =============================================================================
# CONSOMMATION MÉMOIRE ESTIMÉE
# =============================================================================
#
#  Service       RAM min   RAM max   Notes
#  ──────────── ──────── ──────── ────────────────────────────────
#  llama-cpp     2.0 GB   4.0 GB   Dépend modèle + contexte
#  open-webui    256 MB   768 MB
#  litellm       128 MB   384 MB
#  ai-gateway     96 MB   256 MB
#  redis          64 MB   192 MB
#  ──────────── ──────── ──────── ────────────────────────────────
#  TOTAL         2.5 GB   5.6 GB   (vs ~20 GB pour la stack Full)
#
#  ✅ ZimaBoard 832 (8 GB)  — modèle 1.5B ou 3B
#  ✅ ZimaBoard 216 (4 GB)  — modèle 1.5B + CTX=1024 obligatoire
#  ✅ Raspberry Pi 5 (8 GB) — modèle 3B
#  ✅ Mini-PC N100 (16 GB)  — modèle 7B
